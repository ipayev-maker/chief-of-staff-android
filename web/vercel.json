{
  "installCommand": "npm ci --ignore-scripts --omit=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/session",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-dashboard/session"
    },
    {
      "source": "/api/session/logout",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-dashboard/logout"
    },
    {
      "source": "/api/gmail/:path*",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-google-calendar/gmail/:path*"
    },
    {
      "source": "/api/notes",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-notes"
    },
    {
      "source": "/api/notes/:path*",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-notes/:path*"
    },
    {
      "source": "/api/google-calendar/:path*",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-google-calendar/:path*"
    },
    {
      "source": "/rest/v1/:path*",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-dashboard/rest/v1/:path*"
    },
    {
      "source": "/functions/v1/:path*",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-dashboard/ai/:path*"
    },
    {
      "source": "/storage/v1/:path*",
      "destination": "https://spabmyyxiufuzsaydrmx.supabase.co/functions/v1/cos-dashboard/storage/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/rest/v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/functions/v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/storage/v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/google-calendar/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/notes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/notes/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/gmail/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self' https://chief-of-staff-v3-live.vercel.app https://nikodim.vercel.app https://accounts.google.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/session",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/session/logout",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
